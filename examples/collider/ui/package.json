{
  "name": "collider-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --config config/vite.config.ts",
    "build": "node ./node_modules/typescript/bin/tsc -b config/tsconfig.app.json && node ./node_modules/vite/bin/vite.js build --config config/vite.config.ts",
    "typecheck": "node ./node_modules/typescript/bin/tsc -b config/tsconfig.app.json --pretty false",
    "postbuild": "node postbuild.js",
    "preview": "node ./node_modules/vite/bin/vite.js preview --config config/vite.config.ts",
    "kill": "pkill -f Collider 2>/dev/null || true",
    "open": "open ~/Applications/MRT2\\ -\\ Collider.app",
    "copy": "cp -r dist/* ~/Applications/MRT2\\ -\\ Collider.app/Contents/Resources/collider_ui/",
    "cmake": "cd ../../.. && .venv/bin/cmake --build build --target deploy_mrt2_collider -j10",
    "launch": "npm run kill && npm run cmake && npm run open",
    "launch:ui": "npm run build && npm run kill && npm run copy && npm run open",
    "launch:dev": "npm run kill && npm run open"
  },
  "dependencies": {
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@magenta-rt/common": "workspace:*",
    "@mui/icons-material": "^6.1.10",
    "@mui/material": "^6.1.10",
    "lil-gui": "^0.21.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2",
    "vite": "^6.4.2",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
